# Variables serveur uniquement : jamais de préfixe NEXT_PUBLIC_* sur un secret.
# Le navigateur ne voit plus ni la clé API ni l'URL backend : tout passe par le BFF
# (app/api/auth/*, app/api/backend/[...path]).

BACKEND_API_BASE_URL=http://localhost:3010
# Même valeur que API_KEY dans backend/.env.
# Le build de contrôle (porte de sortie du lot 2) se lance avec cette valeur sentinelle :
# BACKEND_API_KEY=sentinel-backend-secret pnpm run build
# — elle ne doit apparaître dans aucun fichier produit par `pnpm run build` (bundle .next).
BACKEND_API_KEY=sentinel-backend-secret

# Secret HMAC du jeton CSRF en double soumission (lié à la session, sans état serveur).
CSRF_SECRET=replace_with_a_long_random_secret

# Cookie de session HttpOnly posé par le BFF.
# ATTENTION : en runtime Edge, Next substitue les `process.env.*` AU BUILD, alors que les route
# handlers Node les lisent à l'exécution. Cette variable doit donc être présente au moment du
# `pnpm run build` (pas seulement au démarrage du conteneur), sinon middleware.ts cherche un
# cookie nommé différemment de celui posé par les route handlers et aucun utilisateur
# authentifié n'atteint jamais une page protégée.
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_SECURE=true

# Liste blanche d'origines de confiance pour la vérification CSRF/Origin des mutations
# (séparées par des virgules). Comparée à l'en-tête Origin, jamais à Host/X-Forwarded-Host
# (ces deux-là viennent du client et ne prouvent rien seuls). Sans valeur, toute mutation est
# refusée par défaut.
ALLOWED_ORIGINS=http://localhost:3000
