PORT=3010
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=api_score_app
# Optionnel : laisser vide pour une base locale sans mot de passe ; obligatoire hors poste de dev.
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_DATABASE=api_score
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace_with_real_key
API_FOOTBALL_HOST=v3.football.api-sports.io
REQUEST_TIMEOUT_MS=30000
RETRY_MAX=3
RATE_LIMIT_PER_MIN=300
CORS_ENABLED=true
CORS_ORIGIN=*
LIVE_FIXTURES_SYNC_ENABLED=true
LIVE_FIXTURES_SYNC_INTERVAL_MS=30000
SYNC_RATE_LIMIT_HEADROOM_PCT=90
LIVE_READ_CACHE_TTL_MS=30000
ODDS_SYNC_ENABLED=false
ODDS_PREMATCH_SYNC_INTERVAL_MS=3600000
ODDS_LIVE_SYNC_INTERVAL_MS=120000

# Retention. DATA_RETENTION_DAYS couvre les fixtures et, par cascade, les
# snapshots et evenements : c'est la matiere premiere des taux de base et du
# backtest. Defaut 3 saisons, plancher 365 jours. Les payloads bruts sont
# volumineux et reimportables, d'ou une retention plus courte.
DATA_RETENTION_DAYS=1095
PAYLOAD_RETENTION_DAYS=90


API_KEY=your_api_key_here_min_16_chars
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

# CREATE_ADMIN_EMAIL et CREATE_ADMIN_PASSWORD ne sont lues que par
# `npm run create-admin` : a passer a l'invocation de la CLI (variables
# d'environnement du process, pas de ce fichier), jamais au process API -
# un mot de passe admin ne doit pas persister dans le .env charge par l'API.
# Exemple : CREATE_ADMIN_EMAIL=admin@example.com CREATE_ADMIN_PASSWORD=*** npm run create-admin

# Simulation continue (lot 5) : ordres strictement virtuels, aucun opérateur contacté.
# Désactivée par défaut ; l'intervalle est borné entre 5 s et 10 min.
SIMULATION_SCHEDULER_ENABLED=false
SIMULATION_TICK_INTERVAL_MS=30000

# Exécution bornée (lots 6-7). Les trois verrous restent fermés par défaut.
# REAL_MONEY_INTERLOCK ne suffit jamais à activer LIVE_CANARY.
REAL_MONEY_INTERLOCK=false
# Réconciliation périodique des ordres ; activation explicite après QA/review.
RECONCILIATION_SCHEDULER_ENABLED=false
RECONCILIATION_INTERVAL_MS=300000
